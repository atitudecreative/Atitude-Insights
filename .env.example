# ---------------------------------------------------------------------------
# Atitude Insights — variáveis de ambiente (valores ILUSTRATIVOS)
# Copie para .env.local e preencha. Nunca versione credenciais reais.
# ---------------------------------------------------------------------------

# PostgreSQL (Supabase, Neon, RDS ou local). Usuário dono do schema `app`.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/atitude_insights

# URL pública da aplicação (usada em callbacks OAuth e links de convite).
APP_URL=http://localhost:3000

# Chave de 32 bytes em base64 para cifrar credenciais das integrações.
# Gere com: openssl rand -base64 32
ENCRYPTION_KEY=troque-por-uma-chave-base64-de-32-bytes-gerada-com-openssl
# Durante uma rotação de chave, mantenha a anterior aqui até rodar `npm run keys:rotate`.
ENCRYPTION_KEY_PREVIOUS=

# Segredo do endpoint de agendamento (/api/cron/sync). Mínimo 24 caracteres.
CRON_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Sessão: expiração por inatividade (horas) e absoluta (dias).
SESSION_IDLE_HOURS=72
SESSION_ABSOLUTE_DAYS=14

# Asana (opcional: OAuth). Sem estas variáveis, use Personal Access Token.
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=

# Meta (Facebook Login for Business / Marketing API / Instagram Graph API).
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0

# Identidade visual padrão (pode ser alterada em Administração → Configurações).
BRAND_NAME=Atitude Insights
BRAND_ORGANIZATION=Agência de Comunicação
BRAND_PRIMARY_COLOR=#4f46e5
